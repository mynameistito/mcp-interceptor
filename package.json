{
  "name": "mcp-interceptor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "deploy": "bun run build && wrangler deploy --minify",
    "dev": "wrangler dev",
    "postinstall": "bun run cf-typegen",
    "preview": "bun run build && vite preview",
    "typecheck": "bun run cf-typegen && react-router typegen && tsc",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@counterscale/tracker": "^3.4.1",
    "hono": "^4.11.7",
    "isbot": "^5.1.34",
    "partysocket": "^1.1.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@cloudflare/vite-plugin": "^1.22.1",
    "@react-router/dev": "^7.13.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "lefthook": "^2.0.16",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "ultracite": "^7.1.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "wrangler": "^4.61.1"
  }
}
